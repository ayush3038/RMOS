# RMOS Frontend Environment Template
# Copy this file to .env.local for local development.
# DO NOT COMMIT actual environment files containing secrets.

# Backend REST API
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Backend realtime endpoint
VITE_REALTIME_ENDPOINT=http://localhost:8080/api/v1/realtime

# Application environment
VITE_APP_ENV=development

# Synthetic data mode
VITE_SIMULATION_MODE=true

# Expected simulator update interval in seconds
VITE_SIMULATION_INTERVAL_SEC=8
