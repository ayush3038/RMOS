# RMOS Backend Environment Template
# Copy this file to .env and update values for local development.
# DO NOT COMMIT actual .env files to version control.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rmos
SPRING_DATASOURCE_USERNAME=placeholder_username
SPRING_DATASOURCE_PASSWORD=placeholder_password

# JWT / Security Configuration
JWT_SECRET=placeholder_jwt_secret_key_change_in_production
JWT_EXPIRATION_MS=3600000

# Realtime / Server Configuration
SERVER_PORT=8080

# Simulation Configuration
# Set to 'true' to enable the synthetic data event generator (default for local)
SIMULATION_MODE=true
# Default interval for simulator events in seconds
SIMULATION_INTERVAL_SEC=8

# NVIDIA NIM / LLM Configuration
NIM_API_KEY=placeholder_nim_api_key
NIM_MODEL_NAME=meta/llama-3.1-70b-instruct
NIM_API_BASE=https://integrate.api.nvidia.com/v1

# Supabase PostgreSQL Configuration
SUPABASE_DB_URL=jdbc:postgresql://your-supabase-project.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=placeholder_supabase_password

# RAG Knowledge Configuration
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSIONS=1024
