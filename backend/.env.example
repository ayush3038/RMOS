# RMOS Backend Environment Template
# Copy this file to .env and update values for local development.
# DO NOT COMMIT actual .env files to version control.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rmos
SPRING_DATASOURCE_USERNAME=placeholder_username
SPRING_DATASOURCE_PASSWORD=placeholder_password

# JWT / Security Configuration
# Used as the HS256 signing key (must be at least 32 bytes).
JWT_SECRET=placeholder_jwt_secret_key_change_in_production
# Token lifetime in seconds (not milliseconds).
JWT_EXPIRATION_SEC=3600

# Realtime / Server Configuration
SERVER_PORT=8080

# CORS
RMOS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Simulation Configuration
# Set to 'true' to enable the synthetic data event generator (default for local)
SIMULATION_MODE=true
# Default interval for simulator events in seconds
SIMULATION_INTERVAL_SEC=8

# Demo account (intentionally public for the demo environment)
RMOS_DEMO_USERNAME=admin
RMOS_DEMO_PASSWORD=demo123
RMOS_DEMO_ROLE=ADMIN
RMOS_DEMO_ENABLED=true
# DEVELOPMENT ONLY: if a pre-existing local database holds a stale 'admin'
# password hash (which makes the documented demo login fail with
# "Invalid username or password"), set this to true once to reset that single
# demo account to RMOS_DEMO_PASSWORD. It is hard-disabled under the prod profile
# and never touches any other user.
RMOS_DEMO_REPAIR_PASSWORD=false
# Baseline simulation-data seeding (demo/simulation only, skipped under prod).
# Creates the SINGLETON_STATE simulator row exactly once so the scheduler is not
# a silent no-op on a fresh database.
RMOS_DEMO_SIMULATION_ENABLED=true

# LOCAL DEMO LOGIN TROUBLESHOOTING
# If POST /api/v1/auth/login returns "Invalid username or password" with
# admin/demo123, the local database is holding a different admin hash. Run the
# backend once with RMOS_DEMO_REPAIR_PASSWORD=true and restart it normally.
# On startup the backend logs whether the demo account was CREATED, ALREADY
# EXISTS (usable / needs repair), or REPAIRED. It never logs passwords or hashes.

# Google Gemini (Generative Language API) - PRIMARY hosted AI provider.
# Create a key at https://aistudio.google.com/apikey (free tier).
#
# LOCAL SETUP - set the key in the SAME PowerShell session that starts the
# backend, never in a tracked file:
#   $env:GEMINI_API_KEY = "YOUR_REAL_KEY"
#   $env:GEMINI_MODEL   = "gemini-3.1-flash-lite"
#   cd backend; ./mvnw.cmd spring-boot:run -Dspring-boot.run.profiles=dev
#
# The value below is a PLACEHOLDER - it is not a working key and RMOS treats it
# as "not configured" (the provider stays disabled rather than failing calls).
GEMINI_API_KEY=PASTE_YOUR_REAL_KEY_HERE
# Stable Google model with a free tier. Do NOT switch to a paid model and do NOT
# enable billing; RMOS never falls back to a paid provider.
GEMINI_MODEL=gemini-3.1-flash-lite
# Free-tier requests may be used by Google to improve its products - send only
# synthetic/demo railway data to the third-party service.
GEMINI_TIMEOUT_SECONDS=45

# RENDER (production) - set the same two variables in the Render dashboard
# Environment tab. Never add the key to Cloudflare frontend variables.
#   GEMINI_API_KEY   = your real key
#   GEMINI_MODEL     = gemini-3.1-flash-lite
# The prod profile already defaults the chain to gemini only, so Ollama is never
# selected on Render.

# NVIDIA NIM / LLM Configuration
# Shared by structured explanations, embeddings (RAG) and the AI chat assistant.
# Hosted endpoint: request an API key at build.nvidia.com. Access, quotas and
# pricing are defined by NVIDIA - verify current terms before relying on it.
# Access is currently blocked pending NVIDIA account verification, so the NIM
# provider stays unconfigured and is skipped.
# For fully local inference, point RMOS_NIM_BASE_URL at a local NIM container
# (API key optional on loopback) or use the Ollama chat provider below.
RMOS_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
RMOS_NIM_MODEL=meta/llama-3.1-8b-instruct
RMOS_NIM_API_KEY=placeholder_nim_api_key

# AI Assistant chat provider chain, tried left to right. "none" disables chat.
# "gemini" = Google Gemini free tier (hosted PRIMARY; used on Render)
# "ollama" = free local open-source models via Ollama (localhost only)
# Gemini-only by default so a missing/unusable key is reported honestly instead
# of being silently answered by Ollama. To opt into the local fallback:
#   $env:RMOS_AI_CHAT_PROVIDER = "gemini,ollama"
#   ollama pull llama3.2
RMOS_AI_CHAT_PROVIDER=gemini
#RMOS_AI_CHAT_MODEL=
#RMOS_AI_CHAT_API_KEY=
#RMOS_AI_CHAT_GEMINI_BASE_URL=
#RMOS_AI_CHAT_GEMINI_MODEL=
#RMOS_AI_CHAT_GEMINI_API_KEY=
#RMOS_AI_CHAT_NIM_BASE_URL=
#RMOS_AI_CHAT_NIM_MODEL=
#RMOS_AI_CHAT_OLLAMA_BASE_URL=http://localhost:11434
#RMOS_AI_CHAT_OLLAMA_MODEL=llama3.2
#RMOS_AI_CHAT_TIMEOUT_SECONDS=45
#RMOS_AI_CHAT_MAX_INPUT_CHARS=4000
#RMOS_AI_CHAT_MAX_HISTORY_MESSAGES=12

# Supabase PostgreSQL Configuration
SUPABASE_DB_URL=jdbc:postgresql://your-supabase-project.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=placeholder_supabase_password

# RAG Knowledge Configuration
# Requires RMOS_NIM_API_KEY above; without it chat still works but cannot
# retrieve ingested railway documentation.
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSIONS=1024
